# Environment & Logging
RAPHAEL_ENV=development
RAPHAEL_LOG_LEVEL=INFO

# AI Providers
NIM_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Audio & Voice Settings
WAKE_WORD=hey raphael
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
STT_MODEL=medium.en
