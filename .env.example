# Environment & Logging
RAPHAEL_ENV=development
RAPHAEL_LOG_LEVEL=INFO

# AI Providers
NIM_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Audio & Voice Settings
WAKE_WORD=hey raphael
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
STT_MODEL=medium.en
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
# piper = in-process ONNX (custom_voice after training). edge_tts needs network.
# Drop licensed source video/audio in training/raw then: python -m raphael prepare-voice
TTS_ENGINE=piper
TTS_VOICE=custom_voice
TTS_SPEED=1.0
TTS_ENABLED=true
FISH_SPEECH_URL=http://127.0.0.1:8080/v1/tts
FISH_REF_AUDIO=data/voices/mommy/ref.wav
FISH_REF_TEXT="Oh my god, did I like break your ribs or something? It's not my fault that you're fragile."

# Listening latency: raise these if you prefer more decoding or longer pauses
STT_BEAM_SIZE=3
UTTERANCE_SILENCE_SECONDS=1.0
